# Supabase próprio do MA Concepty
# Painel Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Licenciamento comercial Tadeu Apps
EXPO_PUBLIC_TADEU_APPS_URL=https://tadeu-apps-core-test2.vercel.app
EXPO_PUBLIC_TADEU_APPS_SUPABASE_URL=https://seu-projeto-tadeu-apps.supabase.co
# Chave pública/publishable somente. Nunca coloque service-role no app.
EXPO_PUBLIC_TADEU_APPS_SUPABASE_ANON_KEY=sua-chave-publica-tadeu-apps

# Web Push (aviso na tela do celular pela versao web)
# Gere o par com: npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
