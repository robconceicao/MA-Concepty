# Supabase (Etapa 2 / Etapa 4)
# Painel Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Web Push (aviso na tela do celular pela versao web)
# Gere o par com: npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
